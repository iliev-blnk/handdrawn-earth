{
  "name": "handdrawn-earth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "api:dev": "wrangler dev --config api/wrangler.jsonc --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p api",
    "smoke": "node e2e/smoke.mjs",
    "deploy:api": "wrangler deploy --config api/wrangler.jsonc",
    "deploy:site": "pnpm build && wrangler pages deploy dist --project-name handdrawn-earth --branch main"
  },
  "dependencies": {
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
